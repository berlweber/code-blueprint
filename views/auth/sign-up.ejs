<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
  <%- include('../partials/_authNavbar.ejs') %>
    <%- include('../partials/_projectsNavbar.ejs') %>
  <main>
    <%- include('../partials/_docsNavbar.ejs') %>
    <h1>Create a CodeBlueprint account</h1>
    <p class="security-note">
      Choose a unique password for this project planning app. Do not enter passwords,
      payment details, or financial information from any other service.
    </p>
    <form class="form" action="/auth/sign-up" method="POST">
      <label for="username">CodeBlueprint username:</label>
      <input type="text" name="username" id="username" autocomplete="username" required />
      <label for="password">New CodeBlueprint password:</label>
      <input type="password" name="password" id="password" autocomplete="new-password" required />
      <label for="confirmPassword">Confirm CodeBlueprint password:</label>
      <input 
        type="password"
        name="confirmPassword"
        id="confirmPassword"
        autocomplete="new-password"
        required 
      />
      <button type="submit">Sign up</button>
    </form>
  </main>
</body>
</html>
