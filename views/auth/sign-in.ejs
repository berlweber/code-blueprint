<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
</head>
<body>
    <%- include('../partials/_authNavbar.ejs') %>
    <%- include('../partials/_projectsNavbar.ejs') %>
    <main>
        <%- include('../partials/_docsNavbar.ejs') %>
    
        <h1>Sign in to CodeBlueprint</h1>
        <p class="security-note">
            Use only your CodeBlueprint username and password. This app will never ask for
            banking, payment, or third-party account credentials.
        </p>
        <form class="form" action="/auth/sign-in" method="POST">
            <label for="username">CodeBlueprint username:</label>
            <input type="text" name="username" id="username" autocomplete="username" required />
            <label for="password">CodeBlueprint password:</label>
            <input type="password" name="password" id="password" autocomplete="current-password" required />
            <button type="submit">Sign in</button>
        </form>
    </main>
</body>
</html>
