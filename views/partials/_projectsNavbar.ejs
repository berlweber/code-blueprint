<div id="projectsnav">
    <h3>My Projects</h3>
    <% const visibleProjects = typeof projects !== 'undefined' ? projects : []; %>
    <% if (user) {%>
    <a href="/projects/new" id="newproj" class="btn">Start A New Project</a>
    
        <% visibleProjects.forEach(project => { %>
            <a href="/projects/<%= project._id %>" class="btn"><%= project.name %> </a>
        <% }) %>
    
    <% } else { %>
        <p>Your projects appear here after you sign in.</p>
    <% } %>
</div>
